{
  "version": "6.0",
  "screens": [
    {
      "id": "PARCEL_DETAILS",
      "title": "Fetch My Parcel",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Please provide your apartment details so our runner can bring your parcel up."
          },
          {
            "type": "TextInput",
            "name": "unit_number",
            "label": "Unit Number",
            "required": true,
            "input-type": "text"
          },
          {
            "type": "Dropdown",
            "name": "courier_name",
            "label": "Courier Service",
            "required": true,
            "data-source": [
              { "id": "takealot", "title": "Takealot" },
              { "id": "shein", "title": "Shein / Temu" },
              { "id": "dhl_aramex", "title": "DHL / Aramex / Courier Guy" },
              { "id": "other", "title": "Other / Unknown" }
            ]
          },
          {
            "type": "TextInput",
            "name": "special_instructions",
            "label": "Delivery Notes",
            "required": false,
            "input-type": "text"
          },
          {
            "type": "Footer",
            "label": "Request Runner",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "unit_number": "${form.unit_number}",
                "courier_name": "${form.courier_name}",
                "special_instructions": "${form.special_instructions}"
              }
            }
          }
        ]
      }
    }
  ]
}
