{
  "version": "6.0",
  "screens": [
    {
      "id": "VISITOR_INFO",
      "title": "Issue Visitor Pass",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Pre-clear your guest or service provider for seamless access at the entry gate."
          },
          {
            "type": "TextInput",
            "name": "visitor_name",
            "label": "Visitor Full Name",
            "required": true,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "visitor_mobile",
            "label": "Mobile Number",
            "required": false,
            "input-type": "phone"
          },
          {
            "type": "Dropdown",
            "name": "entry_type",
            "label": "Access Type",
            "required": true,
            "data-source": [
              { "id": "pedestrian", "title": "Pedestrian / Walk-in" },
              { "id": "vehicle", "title": "Vehicle Entry" },
              { "id": "uber_bolt", "title": "E-Hailing (Uber / Bolt)" },
              { "id": "contractor", "title": "Contractor / Service Delivery" }
            ]
          },
          {
            "type": "TextInput",
            "name": "vehicle_reg",
            "label": "License Plate",
            "required": false,
            "input-type": "text"
          },
          {
            "type": "Footer",
            "label": "Generate Gate Pass",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "visitor_name": "${form.visitor_name}",
                "visitor_mobile": "${form.visitor_mobile}",
                "entry_type": "${form.entry_type}",
                "vehicle_reg": "${form.vehicle_reg}"
              }
            }
          }
        ]
      }
    }
  ]
}
